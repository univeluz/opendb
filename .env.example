# Bu faylni .env deb nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env

# Django
# Yangi tasodifiy qiymat yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-matn-qoying
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Ma'lumotlar bazasi (Postgres, docker-compose uchun)
# Eslatma: docker-compose.yml DB_HOST'ni avtomatik "db" ga o'rnatadi,
# bu yerdagi qiymat faqat Docker'siz (lokal SQLite bilan) ishga tushirishda ishlatiladi.
DB_NAME=opendb
DB_USER=opendb
DB_PASSWORD=kuchli-parol-qoying
DB_HOST=
DB_PORT=5432

# Superuser (birinchi marta docker-compose up qilinganda avtomatik yaratiladi)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@opendb.uz
DJANGO_SUPERUSER_PASSWORD=

# API rate limit (ixtiyoriy, standart: 1000/day)
ANON_THROTTLE_RATE=1000/day
